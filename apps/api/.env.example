NODE_ENV=development
PORT=4000

# Postgres from infrastructure/docker/docker-compose.yml
DATABASE_URL=postgresql://edumanage:edumanage@localhost:5433/edumanage?schema=public
REDIS_URL=redis://localhost:6380

# Signs mobile access tokens. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_ISSUER=edumanage

# Origin of the Next.js web app (allowed to use the session cookie)
WEB_ORIGIN=http://localhost:3000

# First platform Super Admin, created by `pnpm db:seed` (at least 10 characters)
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=change-me-please
